# 로컬 환경 값 (.env.example 만 커밋한다)
.env
local/.env

# Terraform 로컬 상태와 설정
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Kubernetes 접속 설정
kubeconfig
*.kubeconfig

# 팀 로컬 실행의 소스·비밀정보·백업·로그
/.local-team/
__pycache__/

# 에이전트 작업 아티팩트
.omc/

# P2 팀 설명 문서는 Notion에서 관리한다.
/k8s/p2-security.md
/local/p2/README.md

# 개발 도구 설정
.idea/
*.iml
.vscode/

# 운영체제 생성 파일
.DS_Store

# AWS NLB 주소를 다음 apply에서도 유지하는 로컬 값
/terraform/envs/dev/aws-runtime.auto.tfvars.json
