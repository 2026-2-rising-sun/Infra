# local/docker-compose.yml 이 읽는 환경변수 예시.
# 실제 사용 시 `cp local/.env.example local/.env` 후 값을 채운다.
# .env 는 커밋하지 않는다 (.gitignore 에 등록돼 있음).

# --- PostgreSQL ---
POSTGRES_USER=shoppinglive
POSTGRES_PASSWORD=<set-a-local-password>
POSTGRES_PORT=5432
# 서비스별로 생성할 DB 목록 (콤마 구분). 최초 기동 시에만 반영된다.
POSTGRES_MULTIPLE_DATABASES=member,shopping,commerce,live,notification

# --- Redis ---
REDIS_PORT=6379

# --- Kafka (KRaft 단일 브로커) ---
# 호스트에서 접속할 때 쓰는 EXTERNAL 리스너 포트.
# Backend 로컬 실행 시 bootstrap-servers=localhost:29092
KAFKA_PORT=29092

# --- 확인용 관리 UI (--profile tools 로 띄울 때만 쓰인다) ---
KAFKA_UI_PORT=8090
REDISINSIGHT_PORT=5540
