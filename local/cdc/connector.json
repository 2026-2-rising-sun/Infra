{
  "name": "core-catalog-outbox",
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "catalog_cdc",
  "database.dbname": "commercecore",
  "plugin.name": "pgoutput",
  "topic.prefix": "core_catalog_cdc",
  "slot.name": "core_catalog_outbox",
  "slot.drop.on.stop": "false",
  "publication.name": "core_catalog_outbox",
  "publication.autocreate.mode": "disabled",
  "schema.include.list": "public",
  "table.include.list": "public.event_outbox",
  "snapshot.mode": "initial",
  "tombstones.on.delete": "false",
  "include.schema.changes": "false",
  "provide.transaction.metadata": "false",
  "heartbeat.interval.ms": "10000",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.storage.StringConverter",
  "header.converter": "org.apache.kafka.connect.storage.SimpleHeaderConverter",
  "errors.tolerance": "none",
  "predicates": "outboxTable",
  "predicates.outboxTable.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.outboxTable.pattern": "core_catalog_cdc\\.public\\.event_outbox",
  "transforms": "catalogOnly,outbox",
  "transforms.catalogOnly.type": "io.debezium.transforms.Filter",
  "transforms.catalogOnly.predicate": "outboxTable",
  "transforms.catalogOnly.language": "jsr223.groovy",
  "transforms.catalogOnly.condition": "value != null && (value.op == 'c' || value.op == 'r') && value.after != null && value.after.topic == 'commerce.catalog.snapshots.v1'",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.predicate": "outboxTable",
  "transforms.outbox.table.field.event.id": "event_id",
  "transforms.outbox.table.field.event.key": "message_key",
  "transforms.outbox.table.field.event.payload": "payload",
  "transforms.outbox.table.expand.json.payload": "false",
  "transforms.outbox.table.fields.additional.placement": "event_id:header:eventId,event_type:header:eventType",
  "transforms.outbox.route.by.field": "topic",
  "transforms.outbox.route.topic.regex": "(?<routedByValue>.*)",
  "transforms.outbox.route.topic.replacement": "${routedByValue}"
}
